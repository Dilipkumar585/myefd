rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // ===== Helper Functions =====
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isAgent() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role.matches('.*Agent$');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validate order has required fields on creation
    function isValidNewOrder() {
      return request.resource.data.keys().hasAll([
        'service', 'location', 'status', 'customerId', 'createdAt', 'phone'
      ]) && request.resource.data.status == 'Pending'
        && request.resource.data.customerId == request.auth.uid;
    }

    // Validate rating fields
    function isValidRating() {
      return request.resource.data.keys().hasAll([
        'orderId', 'userId', 'rating', 'createdAt'
      ]) && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
    }

    // ===== Users Collection =====
    match /users/{userId} {
      // Any authenticated user can read user documents
      allow read: if isAuthenticated();

      // Users can create their own document only
      allow create: if isOwner(userId);

      // Users can update their own doc, Admin can update any
      allow update: if isOwner(userId) || isAdmin();

      // Only admin can delete users
      allow delete: if isAdmin();

      // Validate required fields on create
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['name', 'email', 'role', 'uid']);
    }

    // ===== Orders Collection =====
    match /orders/{orderId} {
      // Create: Authenticated users can create orders with validation
      allow create: if isAuthenticated() && isValidNewOrder();

      // Read:
      // - Customer can read their own orders
      // - Assigned agent can read their orders
      // - Admin can read all orders
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );

      // Update:
      // - Customer can update their own pending/accepted orders (e.g., cancel)
      // - Assigned agent can update orders assigned to them
      // - Admin can update any order
      allow update: if isAuthenticated() && (
        (resource.data.customerId == request.auth.uid &&
         (resource.data.status == 'Pending' || resource.data.status == 'Accepted')) ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );

      // Delete: Only admin can delete
      allow delete: if isAdmin();
    }

    // ===== Ratings Collection =====
    match /ratings/{ratingId} {
      // Authenticated users can create ratings with validation
      allow create: if isAuthenticated() && isValidRating();

      // Anyone authenticated can read ratings
      allow read: if isAuthenticated();

      // Only admin can update/delete ratings
      allow update, delete: if isAdmin();
    }

    // ===== Deny everything else by default =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

